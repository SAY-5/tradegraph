# Edges of the subsidiary tree under ${iri}, at most ${depth} levels down.
SELECT ?parent ?child ?childName ?jurisdiction (GROUP_CONCAT(DISTINCT ?t; separator=",") AS ?childTypes)
WHERE {
  { BIND(${iri} AS ?parent) } ${moreParents}
  ?child tg:subsidiaryOf ?parent ; tg:name ?childName ; a ?t .
  ${directOnly}
  OPTIONAL { ?child tg:jurisdiction ?jurisdiction }
  FILTER(?t != tg:LegalEntity && ?t != tg:Counterparty)
}
GROUP BY ?parent ?child ?childName ?jurisdiction
ORDER BY ?childName
