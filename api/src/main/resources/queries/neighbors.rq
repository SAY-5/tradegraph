# Adjacent entities of ${iri} for the explorer: parent, subsidiaries, and the
# strongest holding relationships in either direction.
SELECT ?other ?otherName ?rel ?weight (GROUP_CONCAT(DISTINCT ?t; separator=",") AS ?otherTypes)
WHERE {
  {
    { SELECT ?other ("PARENT" AS ?rel) (0 AS ?weight) WHERE { ${iri} tg:subsidiaryOf ?other } }
    UNION
    { SELECT ?other ("SUBSIDIARY" AS ?rel) (0 AS ?weight) WHERE { ?other tg:subsidiaryOf ${iri} } }
    UNION
    { SELECT ?other ("HOLDS" AS ?rel) (SUM(?v) AS ?weight)
      WHERE { ${iri} tg:holds ?p . ?p tg:issuer ?other ; tg:value ?v } GROUP BY ?other }
    UNION
    { SELECT ?other ("HELD_BY" AS ?rel) (SUM(?v) AS ?weight)
      WHERE { ?other tg:holds ?p . ?p tg:issuer ${iri} ; tg:value ?v } GROUP BY ?other }
  }
  ?other tg:name ?otherName ; a ?t .
  FILTER(?t != tg:LegalEntity && ?t != tg:Counterparty)
}
GROUP BY ?other ?otherName ?rel ?weight
ORDER BY ?rel DESC(?weight) ?otherName
LIMIT ${limit}
